# Vorlage: kopieren nach .env  (cp .env.example .env)  und bei Bedarf Passwoerter aendern.
# .env wird NICHT eingecheckt (.gitignore). Hier stehen nur lokale Entwicklungswerte.
# Wer Werte aendert, muss sie auch vor dem Start der Anwendung als Umgebungsvariablen setzen
# (die Standardwerte in app/src/main/resources/application.properties entsprechen dieser Datei).

# MySQL
MYSQL_ROOT_PASSWORD=root-dev
MYSQL_DATABASE=pflege_backoffice
MYSQL_USER=pflege
MYSQL_PASSWORD=pflege-dev
MYSQL_PORT=3307

# ActiveMQ Classic
ACTIVEMQ_USER=pflege
ACTIVEMQ_PASSWORD=pflege-dev
ACTIVEMQ_WEB_USER=admin
ACTIVEMQ_WEB_PASSWORD=admin-dev
ACTIVEMQ_PORT=61616
ACTIVEMQ_WEB_PORT=8161

# CIB-seven-Oberflaeche (nur mit: docker compose --profile ui up -d)
CIBSEVEN_UI_PORT=8090
